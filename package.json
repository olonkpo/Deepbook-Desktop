{
  "name": "deepbook-studio",
  "productName": "DeepBook Studio",
  "version": "1.0.4",
  "description": "DeepBook Studio — AI book writing app, powered by your local Claude Code login (no API key).",
  "main": "main.js",
  "author": {
    "name": "DeepBook Studio",
    "email": "noreply@deepbook.studio"
  },
  "private": true,
  "scripts": {
    "start": "electron .",
    "lint": "eslint .",
    "dist": "electron-builder --publish=never",
    "dist:win": "electron-builder --win --publish=never",
    "dist:mac": "electron-builder --mac --publish=never",
    "dist:linux": "electron-builder --linux --publish=never"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "^2.1.281",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "eslint": "^10.11.0",
    "eslint-plugin-html": "^8.2.1",
    "globals": "^17.12.0"
  },
  "build": {
    "appId": "studio.deepbook.app",
    "productName": "DeepBook Studio",
    "compression": "maximum",
    "afterPack": "afterPack.js",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "bridge/**/*",
      "renderer/**/*",
      "node_modules/**/*",
      "!node_modules/@anthropic-ai/claude-code-*/**/*.map"
    ],
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-code/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "olonkpo",
      "repo": "Deepbook-Desktop"
    },
    "win": {
      "target": "nsis",
      "artifactName": "DeepBookStudio-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "artifactName": "DeepBookStudio-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "artifactName": "DeepBookStudio-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    }
  }
}
